<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IPFS.ViewModels"
        xmlns:views="clr-namespace:IPFS.Views"
        x:Class="IPFS.Views.ShellWindow"
        x:DataType="vm:ShellViewModel"
        Title="IPFS 媒体库"
        Icon="avares://IPFS.Avalonia/Assets/IPFS_256x256.ico"
        Width="1180" Height="760"
        MinWidth="960" MinHeight="620"
        Background="{DynamicResource PageBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 顶栏图标：24x24 路径，颜色跟随按钮前景 -->
        <StreamGeometry x:Key="IconBack">M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z</StreamGeometry>
        <StreamGeometry x:Key="IconHome">M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z</StreamGeometry>
        <StreamGeometry x:Key="IconUpload">M9 16h6v-6h4l-7-7-7 7h4v6zm-4 2h14v2H5v-2z</StreamGeometry>
        <StreamGeometry x:Key="IconRefresh">M17.65 6.35A7.958 7.958 0 0012 4a8 8 0 100 16c3.73 0 6.84-2.55 7.73-6h-2.08A6 6 0 1112 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</StreamGeometry>
        <StreamGeometry x:Key="IconCancel">M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>
        <StreamGeometry x:Key="IconGrid">M3 3h8v8H3V3zm10 0h8v8h-8V3zM3 13h8v8H3v-8zm10 0h8v8h-8v-8z</StreamGeometry>
        <StreamGeometry x:Key="IconList">M3 5h18v2H3V5zm0 6h18v2H3v-2zm0 6h18v2H3v-2z</StreamGeometry>
        <StreamGeometry x:Key="IconSettings">M12 8a4 4 0 100 8 4 4 0 000-8zm9.4 4c0-.3-.03-.6-.07-.9l2.1-1.6-2-3.5-2.5 1a7.3 7.3 0 00-1.7-1l-.4-2.6h-4l-.4 2.6c-.6.2-1.2.6-1.7 1l-2.5-1-2 3.5 2.1 1.6c-.04.3-.07.6-.07.9s.03.6.07.9l-2.1 1.6 2 3.5 2.5-1c.5.4 1.1.8 1.7 1l.4 2.6h4l.4-2.6c.6-.2 1.2-.6 1.7-1l2.5 1 2-3.5-2.1-1.6c.04-.3.07-.6.07-.9z</StreamGeometry>

        <!-- 主题切换：月亮=当前浅色（点击转深色），太阳=当前深色 -->
        <StreamGeometry x:Key="IconMoon">M12 3a9 9 0 109 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 01-4.4 2.26 5.4 5.4 0 01-5.4-5.4c0-1.81.89-3.41 2.26-4.4-.44-.06-.9-.1-1.36-.1z</StreamGeometry>
        <StreamGeometry x:Key="IconSun">M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.64 4.58a1 1 0 00-1.41 1.41l1.06 1.06a1 1 0 001.41-1.41L5.64 4.58zm12.37 12.37a1 1 0 00-1.41 1.41l1.06 1.06a1 1 0 001.41-1.41l-1.06-1.06zm1.06-10.96a1 1 0 000-1.41 1 1 0 00-1.41 0l-1.06 1.06a1 1 0 001.41 1.41l1.06-1.06zM7.05 18.36a1 1 0 000-1.41 1 1 0 00-1.41 0l-1.06 1.06a1 1 0 001.41 1.41l1.06-1.06z</StreamGeometry>

        <!-- 详情页播放器图标 -->
        <StreamGeometry x:Key="IconPlay">M8 5v14l11-7z</StreamGeometry>
        <StreamGeometry x:Key="IconPause">M6 19h4V5H6v14zm8-14v14h4V5h-4z</StreamGeometry>
        <StreamGeometry x:Key="IconStop">M6 6h12v12H6z</StreamGeometry>
        <StreamGeometry x:Key="IconOpenFile">M10 4H4a2 2 0 00-2 2v12a2 2 0 002 2h16a2 2 0 002-2V8a2 2 0 00-2-2h-8l-2-2z</StreamGeometry>
        <StreamGeometry x:Key="IconDownload">M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z</StreamGeometry>
        <StreamGeometry x:Key="IconVolume">M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0014 7.97v8.05A4.5 4.5 0 0016.5 12zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z</StreamGeometry>
        <StreamGeometry x:Key="IconVolumeMute">M3 9v6h4l5 5V4L7 9H3z M16.5 12 20 8.5 18.59 7.09 15.09 10.59 11.59 7.09 10.18 8.5 13.68 12 10.18 15.5 11.59 16.91 15.09 13.41 18.59 16.91 20 15.5z</StreamGeometry>
        <StreamGeometry x:Key="IconExpand">M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z</StreamGeometry>
        <StreamGeometry x:Key="IconCollapse">M5 16h3v3h2v-5H5v2zm3-8H5v2h5V5H8v3zm6 11h2v-3h3v-2h-5v5zm2-11V5h-2v5h5V8h-3z</StreamGeometry>
    </Window.Resources>

    <DockPanel>

        <!-- 顶部导航栏 -->
        <Border DockPanel.Dock="Top" Height="36" Padding="8,0"
                Background="{DynamicResource BarBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto">

                <Button Command="{Binding GoBackCommand}" IsVisible="{Binding Navigation.CanGoBack}"
                        Width="26" Height="24" Padding="0" VerticalAlignment="Center"
                        ToolTip.Tip="返回" AutomationProperties.Name="返回">
                    <PathIcon Data="{StaticResource IconBack}" Width="15" Height="15" />
                </Button>

                <Button Grid.Column="1" Margin="6,0,0,0"
                        Command="{Binding ShowHomeCommand}" IsVisible="{Binding !IsHomePage}"
                        Width="26" Height="24" Padding="0" VerticalAlignment="Center"
                        ToolTip.Tip="专辑列表" AutomationProperties.Name="专辑列表">
                    <PathIcon Data="{StaticResource IconHome}" Width="15" Height="15" />
                </Button>

                <!-- 首页专属：上传在左，刷新/切换靠右；远程数据源时隐藏上传 -->
                <Button Grid.Column="2" Margin="6,0,0,0"
                        Command="{Binding Home.UploadCommand}" IsVisible="{Binding IsHomeLocalSource}"
                        Width="26" Height="24" Padding="0" VerticalAlignment="Center"
                        ToolTip.Tip="上传专辑" AutomationProperties.Name="上传专辑">
                    <PathIcon Data="{StaticResource IconUpload}" Width="15" Height="15" />
                </Button>

                <!-- 上传进行中显示取消按钮，离开首页也可取消 -->
                <Button Grid.Column="3" Margin="6,0,0,0" HorizontalAlignment="Left"
                        Command="{Binding Home.CancelUploadCommand}" IsVisible="{Binding Home.IsUploading}"
                        Width="26" Height="24" Padding="0" VerticalAlignment="Center"
                        ToolTip.Tip="取消上传" AutomationProperties.Name="取消上传">
                    <PathIcon Data="{StaticResource IconCancel}" Width="15" Height="15" />
                </Button>

                <Button Grid.Column="4" Margin="6,0,0,0"
                        Command="{Binding Home.RefreshCommand}" IsVisible="{Binding IsHomePage}"
                        Width="26" Height="24" Padding="0" VerticalAlignment="Center"
                        ToolTip.Tip="刷新列表" AutomationProperties.Name="刷新列表">
                    <PathIcon Data="{StaticResource IconRefresh}" Width="15" Height="15" />
                </Button>

                <Button Grid.Column="5" Margin="6,0,0,0"
                        Command="{Binding Home.ToggleViewCommand}" IsVisible="{Binding IsHomePage}"
                        Width="26" Height="24" Padding="0" VerticalAlignment="Center"
                        ToolTip.Tip="{Binding Home.ViewModeText}"
                        AutomationProperties.Name="{Binding Home.ViewModeText}">
                    <Panel>
                        <PathIcon Data="{StaticResource IconList}" Width="15" Height="15"
                                  IsVisible="{Binding Home.IsGridView}" />
                        <PathIcon Data="{StaticResource IconGrid}" Width="15" Height="15"
                                  IsVisible="{Binding !Home.IsGridView}" />
                    </Panel>
                </Button>

				<!-- 主题切换：放在刷新按钮之后，仅首页显示 -->
				<Button Grid.Column="6" Margin="6,0,0,0"
                        Command="{Binding ToggleThemeCommand}" IsVisible="{Binding IsHomePage}"
                        Width="26" Height="24" Padding="0" VerticalAlignment="Center"
                        ToolTip.Tip="切换深色/浅色模式" AutomationProperties.Name="切换主题">
					<Panel>
						<PathIcon Data="{StaticResource IconMoon}" Width="15" Height="15"
                                  IsVisible="{Binding !IsDarkMode}" />
						<PathIcon Data="{StaticResource IconSun}" Width="15" Height="15"
                                  IsVisible="{Binding IsDarkMode}" />
					</Panel>
				</Button>

                <Button Grid.Column="7" Margin="6,0,0,0"
                        Command="{Binding ShowSettingsCommand}" IsVisible="{Binding !IsSettingsPage}"
                        Width="26" Height="24" Padding="0" VerticalAlignment="Center"
                        ToolTip.Tip="设置" AutomationProperties.Name="设置">
                    <PathIcon Data="{StaticResource IconSettings}" Width="15" Height="15" />
                </Button>
            </Grid>
        </Border>

        <!-- 页面容器 -->
        <ContentControl Content="{Binding Navigation.CurrentPage}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:HomeViewModel" x:DataType="vm:HomeViewModel">
                    <views:HomeView />
                </DataTemplate>
                <DataTemplate DataType="vm:DetailViewModel" x:DataType="vm:DetailViewModel">
                    <views:DetailView />
                </DataTemplate>
                <DataTemplate DataType="vm:SettingsViewModel" x:DataType="vm:SettingsViewModel">
                    <views:SettingsView />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
		
    </DockPanel>
    
</Window>
